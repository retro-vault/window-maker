{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "wmaker: build Docker",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/wmaker-docker.sh",
      "args": [
        "build"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "wmaker: prepare Docker",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/wmaker-docker.sh",
      "args": [
        "prepare"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "wmaker: stop Docker",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/wmaker-docker.sh",
      "args": [
        "stop"
      ],
      "problemMatcher": []
    }
  ]
}
