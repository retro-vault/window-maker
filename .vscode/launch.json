{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Window Maker (Docker + Xephyr)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/bin/wmaker",
      "cwd": "${workspaceFolder}",
      "args": [],
      "MIMode": "gdb",
      "stopAtEntry": false,
      "externalConsole": false,
      "preLaunchTask": "wmaker: prepare Docker",
      "postDebugTask": "wmaker: stop Docker",
      "pipeTransport": {
        "pipeProgram": "${workspaceFolder}/.vscode/wmaker-docker.sh",
        "pipeArgs": [
          "debug"
        ],
        "debuggerPath": "gdb",
        "pipeCwd": "${workspaceFolder}"
      },
      "additionalSOLibSearchPath": "${workspaceFolder}/bin/lib",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "text": "handle SIGTERM nostop noprint pass"
        },
        {
          "text": "set disable-randomization off",
          "ignoreFailures": false
        }
      ]
    }
  ]
}
