#!/usr/bin/env bash
# Source this file to put the staged Window Maker tree on your paths:
#
#     source ./bin/use-wmaker.sh
#
# Generated by CMake - do not edit.

WMAKER_PREFIX="@WM_STAGE_PREFIX@"

export PATH="$WMAKER_PREFIX/bin:$PATH"

if [ -n "$LD_LIBRARY_PATH" ]; then
    export LD_LIBRARY_PATH="$WMAKER_PREFIX/lib:$LD_LIBRARY_PATH"
else
    export LD_LIBRARY_PATH="$WMAKER_PREFIX/lib"
fi

if [ -n "$PKG_CONFIG_PATH" ]; then
    export PKG_CONFIG_PATH="$WMAKER_PREFIX/lib/pkgconfig:$PKG_CONFIG_PATH"
else
    export PKG_CONFIG_PATH="$WMAKER_PREFIX/lib/pkgconfig"
fi

# Where Window Maker keeps per-user defaults (normally ~/GNUstep).  Pointing it
# inside the checkout keeps experiments away from a real desktop session.
# Unset WMAKER_USER_ROOT before sourcing this file to use ~/GNUstep instead.
export WMAKER_USER_ROOT="${WMAKER_USER_ROOT:-$WMAKER_PREFIX/../.wmaker-home/GNUstep}"

echo "WMAKER_PREFIX=$WMAKER_PREFIX"
echo "WMAKER_USER_ROOT=$WMAKER_USER_ROOT"
