/*
 * config.h - generated by CMake for Window Maker.
 *
 * This replaces the file that autoheader used to produce from configure.ac.
 * Do not edit: change the top-level CMakeLists.txt instead.
 */

#ifndef WMAKER_CMAKE_CONFIG_H
#define WMAKER_CMAKE_CONFIG_H

/* ------------------------------------------------------------------ */
/* Package identification                                              */
/* ------------------------------------------------------------------ */

#define PACKAGE "@WM_PACKAGE_TARNAME@"
#define PACKAGE_NAME "@WM_PACKAGE_NAME@"
#define PACKAGE_TARNAME "@WM_PACKAGE_TARNAME@"
#define PACKAGE_VERSION "@PROJECT_VERSION@"
#define PACKAGE_STRING "@WM_PACKAGE_NAME@ @PROJECT_VERSION@"
#define PACKAGE_BUGREPORT "@WM_PACKAGE_BUGREPORT@"
#define PACKAGE_URL "@WM_PACKAGE_URL@"
#define VERSION "@PROJECT_VERSION@"

/* ------------------------------------------------------------------ */
/* Header files                                                        */
/* ------------------------------------------------------------------ */

#cmakedefine HAVE_BSD_STRING_H 1
#cmakedefine HAVE_CTYPE_H 1
#cmakedefine HAVE_DLFCN_H 1
#cmakedefine HAVE_FCNTL_H 1
#cmakedefine HAVE_INTTYPES_H 1
#cmakedefine HAVE_LIBINTL_H 1
#cmakedefine HAVE_LIMITS_H 1
#cmakedefine HAVE_MALLOC_H 1
#cmakedefine HAVE_POLL_H 1
#cmakedefine HAVE_STDINT_H 1
#cmakedefine HAVE_STDIO_H 1
#cmakedefine HAVE_STDLIB_H 1
#cmakedefine HAVE_STRINGS_H 1
#cmakedefine HAVE_STRING_H 1
#cmakedefine HAVE_SYSLOG_H 1
#cmakedefine HAVE_SYS_INOTIFY_H 1
#cmakedefine HAVE_SYS_IOCTL_H 1
#cmakedefine HAVE_SYS_STAT_H 1
#cmakedefine HAVE_SYS_TYPES_H 1
#cmakedefine HAVE_SYS_WAIT_H 1
#cmakedefine HAVE_UNISTD_H 1
#cmakedefine STDC_HEADERS 1

/* ------------------------------------------------------------------ */
/* Library functions                                                   */
/* ------------------------------------------------------------------ */

#cmakedefine HAVE_DGETTEXT 1
#cmakedefine HAVE_GETTEXT 1
#cmakedefine HAVE_GETHOSTNAME 1
#cmakedefine HAVE_MALLINFO2 1
#cmakedefine HAVE_MKSTEMP 1
#cmakedefine HAVE_POLL 1
#cmakedefine HAVE_SECURE_GETENV 1
#cmakedefine HAVE_SELECT 1
#cmakedefine HAVE_SETSID 1
#cmakedefine HAVE_STRCASECMP 1
#cmakedefine HAVE_STRNCASECMP 1
#cmakedefine HAVE_STRLCAT 1
#cmakedefine HAVE_SYSCONF 1
#cmakedefine HAVE_VPRINTF 1
#cmakedefine HAVE_FLOAT_MATHFUNC 1
#cmakedefine HAVE_SYSLOG 1
#cmakedefine HAVE_INOTIFY 1

/* Not probed: modern systems always have vprintf() rather than _doprnt() */
/* #undef HAVE_DOPRNT */

/* ------------------------------------------------------------------ */
/* Compiler / libc traits                                              */
/* ------------------------------------------------------------------ */

#cmakedefine HAVE_STDNORETURN 1
#ifndef HAVE_STDNORETURN
#define noreturn @WM_NORETURN_ATTRIBUTE@
#endif

/* Method for defining a library initialisation function */
#define WLIB_CONSTRUCTOR(func_name) @WM_LIB_CONSTRUCTOR@

/* Defines how to access the value of Pi */
#define WM_PI @WM_PI_VALUE@

/* Return type of signal handlers */
#define RETSIGTYPE void

@WM_DEFINE_O_NOFOLLOW@

/* ------------------------------------------------------------------ */
/* POSIX threads (used by wmiv)                                        */
/* ------------------------------------------------------------------ */

#cmakedefine HAVE_PTHREAD 1
#cmakedefine HAVE_PTHREAD_PRIO_INHERIT 1

/* ------------------------------------------------------------------ */
/* X11 traits and extensions                                           */
/* ------------------------------------------------------------------ */

#cmakedefine HAVE_XCONVERTCASE 1
#cmakedefine HAVE_XINTERNATOMS 1
#cmakedefine HAVE_LIBXMU 1

#cmakedefine USE_XSHAPE 1
#cmakedefine USE_XSHM 1
#cmakedefine USE_XINERAMA 1
#cmakedefine USE_RANDR 1
#cmakedefine USE_XRES 1
#cmakedefine USE_XPM 1

/* Only relevant on Solaris; never set by this build */
/* #undef SOLARIS_XINERAMA */
/* #undef X_LOCALE */
/* #undef X_DISPLAY_MISSING */

/* ------------------------------------------------------------------ */
/* Image format libraries                                              */
/* ------------------------------------------------------------------ */

#cmakedefine USE_GIF 1
#cmakedefine USE_JPEG 1
#cmakedefine USE_PNG 1
#cmakedefine USE_TIFF 1
#cmakedefine USE_WEBP 1
#cmakedefine USE_MAGICK 1
#cmakedefine HAVE_EXIF 1

/* ------------------------------------------------------------------ */
/* Optional features                                                   */
/* ------------------------------------------------------------------ */

#cmakedefine USE_ANIMATIONS 1
#cmakedefine USE_DOCK_XDND 1
#cmakedefine USE_MWM_HINTS 1
#cmakedefine USE_ICCCM_WMREPLACE 1
#cmakedefine USER_MENU 1
#cmakedefine XKB_MODELOCK 1
#cmakedefine USE_PANGO 1
#cmakedefine I18N 1
#cmakedefine MENU_TEXTDOMAIN "@MENU_TEXTDOMAIN@"

/* Boehm GC is not wired up in the CMake build */
/* #undef USE_BOEHM_GC */

#include "config-paths.h"

#endif /* WMAKER_CMAKE_CONFIG_H */
